{
	"schemaVersion": 1,
	"id": "modpacksettings",
	"version": "${version}",
	"name": "ModpackSettings",
	"description": "A basic mod that checks the allocated RAM for the Wildeprojekt Modpack",
	"authors": [
		"Speklapje300"
	],
	"contact": {
		"homepage": "https://wildeprojekt.org/"
	},
	"license": "CC0 1.0 Universal",
	"icon": "assets/modpacksettings/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"org.wildeprojekt.modpacksettings.client.ModpackSettingsClient"
		],
        "preLaunch": [
            "org.wildeprojekt.modpacksettings.ModpackSettingsPrelaunch"
        ]
    },
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
